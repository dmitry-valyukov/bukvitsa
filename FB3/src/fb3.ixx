// bukvitsa::fb3 — чтение книг FictionBook 3.
//
// Один импорт на всё: контейнер, метаданные, дерево книги. Обычно нужен только
// `Document` — остальное он отдаёт сам.
//
// Что читатель обязан соблюдать, целиком:
//
//  - дерево живёт ровно столько, сколько `Document`, который его отдал.
//    Тексты узлов — виды в буферы разобранных частей пакета, и книга не
//    копируется ни разу от файла до вёрстки. Поэтому `Document` и
//    неперемещаем: виды указывают внутрь него.
//  - `wxl::core::sta_memory_pool` должен существовать до первого разбора и
//    пережить последнюю книгу — из него берёт память `wxl.xml`. Создаётся один
//    раз в `main()`.
//  - текст книги — `wxl::text::u8_view`: `wxl.xml` проверяет документ целиком,
//    прежде чем его разбирать, и спрашивать об этом заново незачем.
//
// Модуль, а не заголовки: с ними приходилось помнить, что публичный заголовок
// FB3 ведёт к `import wxl.text`, а стандартный заголовок после импорта MSVC не
// принимает, — и всякий, кто включал FB3, был обязан делать это последним,
// после `pch.h` и после своих `<vector>`. Импорту такое не нужно: он не
// заглядывает в чужие макросы и не зависит от того, что разобрали до него.

export module bukvitsa.fb3;

export import :node;
export import :description;
export import :opc;
export import :document;
