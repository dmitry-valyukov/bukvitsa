// Перевод presentation-MathML в TeX.
//
// Формулы приезжают с EPUB: внутри его XHTML математика записана MathML, а
// движок формул Буквицы (MicroTeX, см. Typography/include/.../formula.h)
// разбирает LaTeX. Этот модуль — мост между ними, и живёт он на импорте
// книги: перевести один раз и хранить TeX-строку дешевле, чем таскать по
// модели книги XML-дерево (docs/decisions.md, раздел про формулы).
//
// Диалект — то, что реально пишут издатели и конвертеры (LaTeXML, MathJax):
// токены mi/mn/mo/mtext, дроби, индексы, корни, пределы, скобки, матрицы.
// Незнакомый элемент прозрачен — переводится его содержимое: правило то же,
// что у HTML-подмножества wxl.html, — текст священен, разметка нет.

export module bukvitsa.mathml;

import std;
import wxl.text;

export namespace bukvitsa::mathml {

/// Формула, переведённая в TeX.
struct TexFormula {
    std::wstring tex;

    /// display="block": блочная формула, а не строчная. Вёрстка ставит такую
    /// отдельным боксом с выключкой по центру.
    bool display = false;
};

/// Переводит фрагмент MathML — элемент `<math>`, при необходимости найденный
/// внутри переданного XML, — в TeX-строку для движка формул.
///
/// Вход — проверенный UTF-8: текст EPUB уже прошёл через wxl::text наверху.
/// Пространства имён не сверяются, элементы узнаются по локальным именам:
/// встречается и голый `<math>`, и `<m:math>`, и намеспейс по умолчанию.
///
/// @return nullopt, когда вход не XML, в нём нет `<math>` или вложенность
///         глубже разумного (враждебный вход, а не формула). Всё остальное
///         переводится: незнакомое — содержимым, по правилу выше.
std::optional<TexFormula> toTex(wxl::text::u8_view mathml);

}  // namespace bukvitsa::mathml
